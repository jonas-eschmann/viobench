+// The simulator starts with uniformly distributed sensor biases. Apply this
+// physical prior once at initialization, then retain it through marginalization.
+// Without it, a low-parallax first window can explain a gravity error as a large
+// accelerometer bias and immediately fail the estimator's consistency check.
+class InitialBiasPrior : public ceres::SizedCostFunction<6, 9>
+{
+  public:
+    bool Evaluate(double const *const *parameters, double *residuals, double **jacobians) const override
+    {
+        const double inverse_sigma_a = std::sqrt(3.0) / 0.2;
+        const double inverse_sigma_g = std::sqrt(3.0) / 0.02;
+        for (int i = 0; i < 3; ++i)
+        {
+            residuals[i] = inverse_sigma_a * parameters[0][3 + i];
+            residuals[3 + i] = inverse_sigma_g * parameters[0][6 + i];
+        }
+        if (jacobians && jacobians[0])
+        {
+            Eigen::Map<Eigen::Matrix<double, 6, 9, Eigen::RowMajor>> J(jacobians[0]);
+            J.setZero();
+            J.block<3, 3>(0, 3) = inverse_sigma_a * Eigen::Matrix3d::Identity();
+            J.block<3, 3>(3, 6) = inverse_sigma_g * Eigen::Matrix3d::Identity();
+        }
+        return true;
+    }
+};
+
+// A stationary window supplies zero position/velocity and averaged IMU
+// measurements. The accelerometer residual retains its tilt/bias correlation:
+// horizontal bias uncertainty implies tilt uncertainty, not two independent priors.
+// This factor is consumed by the first marginalization, never re-applied later.
+class StaticInitializationPrior : public ceres::SizedCostFunction<16, 7, 9>
+{
+    Eigen::Quaterniond orientation;
+    Eigen::Matrix3d rotation;
+    Eigen::Vector3d gyro_bias, acceleration;
+    double gyro_sigma;
+  public:
+    StaticInitializationPrior(const Matrix3d& R, const Vector3d& bg, const Vector3d& a, double sigma_bg)
+        : orientation(R), rotation(R), gyro_bias(bg), acceleration(a), gyro_sigma(sigma_bg) {}
+    bool Evaluate(double const *const *parameters, double *residuals, double **jacobians) const override
+    {
+        const Eigen::Map<const Eigen::Vector3d> p(parameters[0]);
+        Eigen::Quaterniond q(parameters[0][6], parameters[0][3], parameters[0][4], parameters[0][5]);
+        Eigen::Quaterniond dq = orientation.conjugate() * q;
+        if (dq.w() < 0) dq.coeffs() *= -1;
+        const Eigen::Vector3d gravity_body = q.conjugate() * G;
+        Eigen::Map<Eigen::Matrix<double, 16, 1>> r(residuals);
+        r.segment<3>(0) = p / 1e-4;
+        r[3] = (rotation * (2.0 * dq.vec())).z() / 1e-4;
+        r.segment<3>(4) = Eigen::Map<const Vector3d>(parameters[1]) / 0.01;
+        r.segment<3>(7) = (gravity_body + Eigen::Map<const Vector3d>(parameters[1] + 3) - acceleration) / 0.04;
+        r.segment<3>(10) = Eigen::Map<const Vector3d>(parameters[1] + 3) * (std::sqrt(3.0) / 0.2);
+        r.segment<3>(13) = (Eigen::Map<const Vector3d>(parameters[1] + 6) - gyro_bias) / gyro_sigma;
+        if (jacobians && jacobians[0])
+        {
+            Eigen::Map<Eigen::Matrix<double, 16, 7, Eigen::RowMajor>> J(jacobians[0]);
+            J.setZero();
+            J.block<3, 3>(0, 0) = Eigen::Matrix3d::Identity() / 1e-4;
+            J.block<1, 3>(3, 3) = rotation.row(2) * (dq.w() * Eigen::Matrix3d::Identity() + Utility::skewSymmetric(dq.vec())) / 1e-4;
+            J.block<3, 3>(7, 3) = Utility::skewSymmetric(gravity_body) / 0.04;
+        }
+        if (jacobians && jacobians[1])
+        {
+            Eigen::Map<Eigen::Matrix<double, 16, 9, Eigen::RowMajor>> J(jacobians[1]);
+            J.setZero();
+            J.block<3, 3>(4, 0) = Eigen::Matrix3d::Identity() / 0.01;
+            J.block<3, 3>(7, 3) = Eigen::Matrix3d::Identity() / 0.04;
+            J.block<3, 3>(10, 3) = Eigen::Matrix3d::Identity() * (std::sqrt(3.0) / 0.2);
+            J.block<3, 3>(13, 6) = Eigen::Matrix3d::Identity() / gyro_sigma;
+        }
+        return true;
+    }
+};
