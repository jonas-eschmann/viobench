+bool Estimator::tryStaticInitialize()
+{
+    const double duration = Headers[WINDOW_SIZE].stamp.toSec() - Headers[0].stamp.toSec();
+    if (duration < 0.8 || duration > 1.5) return false;
+    Vector3d mean_a = Vector3d::Zero(), mean_w = Vector3d::Zero();
+    double total_dt = 0;
+    size_t samples = 0;
+    for (int i = 1; i <= WINDOW_SIZE; ++i)
+        for (size_t k = 0; k < dt_buf[i].size(); ++k)
+        {
+            const double dt = dt_buf[i][k];
+            mean_a += dt * linear_acceleration_buf[i][k];
+            mean_w += dt * angular_velocity_buf[i][k];
+            total_dt += dt;
+            ++samples;
+        }
+    if (samples < 100 || total_dt < 0.8) return false;
+    mean_a /= total_dt;
+    mean_w /= total_dt;
+    if (std::abs(mean_a.norm() - G.norm()) > 0.4 || mean_w.norm() > 0.05) return false;
+    double variance_a = 0, variance_w = 0;
+    for (int i = 1; i <= WINDOW_SIZE; ++i)
+        for (size_t k = 0; k < dt_buf[i].size(); ++k)
+        {
+            variance_a += dt_buf[i][k] * (linear_acceleration_buf[i][k] - mean_a).squaredNorm();
+            variance_w += dt_buf[i][k] * (angular_velocity_buf[i][k] - mean_w).squaredNorm();
+        }
+    if (variance_a / total_dt > 0.7 * 0.7 || variance_w / total_dt > 0.2 * 0.2) return false;
+
+    std::vector<double> disparities;
+    for (const auto& feature : f_manager.feature)
+    {
+        if (feature.start_frame > 1 || feature.start_frame + feature.feature_per_frame.size() < WINDOW_SIZE + 1) continue;
+        const Vector3d& before = feature.feature_per_frame.front().point;
+        const Vector3d& after = feature.feature_per_frame.back().point;
+        disparities.push_back((1.5 * ProjectionFactor::sqrt_info * (before.head<2>() - after.head<2>())).norm());
+    }
+    if (disparities.size() < 30) return false;
+    std::sort(disparities.begin(), disparities.end());
+    if (disparities[disparities.size() / 2] > 1.5 || disparities[9 * disparities.size() / 10] > 2.5) return false;
+
+    initializeStaticWindow(mean_a, mean_w, samples, disparities.size());
+    return true;
+}
+
+void Estimator::initializeStaticWindow(const Vector3d& mean_a, const Vector3d& mean_w,
+                                      size_t samples, size_t tracks)
+{
+    static_prior_rotation = Utility::g2R(mean_a);
+    static_prior_gyro = mean_w;
+    static_prior_acceleration = mean_a;
+    static_prior_gyro_sigma = std::max(0.003, GYR_N / std::sqrt(static_cast<double>(samples)));
+    for (int i = 0; i <= WINDOW_SIZE; ++i)
+    {
+        Bas[i].setZero();
+        Bgs[i] = mean_w;
+        if (pre_integrations[i]) pre_integrations[i]->repropagate(Bas[i], Bgs[i]);
+        if (i == 0) Rs[i] = static_prior_rotation;
+        else Rs[i] = Rs[i - 1] * pre_integrations[i]->delta_q.toRotationMatrix();
+        Ps[i].setZero();
+        Vs[i].setZero();
+    }
+    g = G;
+    static_initialized = true;
+    marginalization_flag = MARGIN_OLD;
+    ROS_WARN("stationary initialization at %.3f (%zu tracks, %zu IMU samples)",
+             Headers[WINDOW_SIZE].stamp.toSec(), tracks, samples);
+}
+
+// Parallax-based INITIAL marginalization deliberately keeps old keyframes. They
+// can contain motion long after the sensor has come to rest. Certify a recent
+// interval independently, then rebuild the lag window from those actual images
+// and IMU samples; never impose zero velocity on the earlier moving interval.
+bool Estimator::tryRecentStaticInitialize()
+{
+    const double now = Headers[WINDOW_SIZE].stamp.toSec();
+    std::vector<map<double, ImageFrame>::iterator> recent;
+    for (auto it = all_image_frame.lower_bound(now - 0.9); it != all_image_frame.end(); ++it)
+        recent.push_back(it);
+    if (recent.size() < WINDOW_SIZE + 1 || now - recent.front()->first < 0.8) return false;
+
+    Vector3d mean_a = Vector3d::Zero(), mean_w = Vector3d::Zero();
+    double total_dt = 0;
+    size_t samples = 0;
+    for (size_t i = 1; i < recent.size(); ++i)
+    {
+        const auto* integration = recent[i]->second.pre_integration;
+        if (!integration || std::abs(integration->sum_dt - (recent[i]->first - recent[i - 1]->first)) > 1e-6)
+            return false;
+        for (size_t k = 0; k < integration->dt_buf.size(); ++k)
+        {
+            const double dt = integration->dt_buf[k];
+            mean_a += dt * integration->acc_buf[k];
+            mean_w += dt * integration->gyr_buf[k];
+            total_dt += dt;
+            ++samples;
+        }
+    }
+    if (samples < 100 || total_dt < 0.8) return false;
+    mean_a /= total_dt;
+    mean_w /= total_dt;
+    if (std::abs(mean_a.norm() - G.norm()) > 0.4 || mean_w.norm() > 0.05) return false;
+    double variance_a = 0, variance_w = 0;
+    for (size_t i = 1; i < recent.size(); ++i)
+    {
+        const auto* integration = recent[i]->second.pre_integration;
+        for (size_t k = 0; k < integration->dt_buf.size(); ++k)
+        {
+            variance_a += integration->dt_buf[k] * (integration->acc_buf[k] - mean_a).squaredNorm();
+            variance_w += integration->dt_buf[k] * (integration->gyr_buf[k] - mean_w).squaredNorm();
+        }
+    }
+    if (variance_a / total_dt > 0.7 * 0.7 || variance_w / total_dt > 0.2 * 0.2) return false;
+
+    // Check maximum excursion throughout the interval, not just equal endpoints:
+    // a camera that rotates away and returns has not remained stationary.
+    std::vector<double> disparities;
+    for (const auto& observation : recent.front()->second.points)
+    {
+        if (observation.second.empty()) continue;
+        const Vector2d before = observation.second.front().second.head<2>();
+        double maximum = 0;
+        bool tracked = true;
+        for (size_t i = 1; i < recent.size(); ++i)
+        {
+            const auto found = recent[i]->second.points.find(observation.first);
+            if (found == recent[i]->second.points.end() || found->second.empty())
+            {
+                tracked = false;
+                break;
+            }
+            const Vector2d after = found->second.front().second.head<2>();
+            maximum = std::max(maximum, (1.5 * ProjectionFactor::sqrt_info * (before - after)).norm());
+        }
+        if (tracked) disparities.push_back(maximum);
+    }
+    if (disparities.size() < 30) return false;
+    std::sort(disparities.begin(), disparities.end());
+    if (disparities[disparities.size() / 2] > 1.5 || disparities[9 * disparities.size() / 10] > 2.5) return false;
+
+    // Replay eleven evenly spaced retained images. The integration between each
+    // selected pair contains every original IMU sample, including skipped images.
+    f_manager.clearState();
+    size_t previous = 0;
+    for (int i = 0; i <= WINDOW_SIZE; ++i)
+    {
+        const size_t index = i * (recent.size() - 1) / WINDOW_SIZE;
+        Headers[i].stamp = ros::Time(recent[index]->first);
+        f_manager.addFeatureCheckParallax(i, recent[index]->second.points, td);
+        delete pre_integrations[i];
+        const auto* first_interval = recent[previous + 1]->second.pre_integration;
+        pre_integrations[i] = new IntegrationBase{first_interval->linearized_acc,
+                                                  first_interval->linearized_gyr,
+                                                  Vector3d::Zero(), mean_w};
+        dt_buf[i].clear();
+        linear_acceleration_buf[i].clear();
+        angular_velocity_buf[i].clear();
+        if (i > 0)
+        {
+            for (size_t frame = previous + 1; frame <= index; ++frame)
+            {
+                const auto* integration = recent[frame]->second.pre_integration;
+                for (size_t k = 0; k < integration->dt_buf.size(); ++k)
+                {
+                    const double dt = integration->dt_buf[k];
+                    const Vector3d& a = integration->acc_buf[k];
+                    const Vector3d& w = integration->gyr_buf[k];
+                    pre_integrations[i]->push_back(dt, a, w);
+                    dt_buf[i].push_back(dt);
+                    linear_acceleration_buf[i].push_back(a);
+                    angular_velocity_buf[i].push_back(w);
+                }
+            }
+        }
+        previous = index;
+    }
+    ROS_INFO("rebuilt stationary initialization window %.3f to %.3f", recent.front()->first, now);
+    // The detector has already certified this exact interval. Do not run another
+    // selection-dependent gate after mutating the window: newly included tracks
+    // could otherwise reject initialization with old poses at new timestamps.
+    initializeStaticWindow(mean_a, mean_w, samples, disparities.size());
+    return true;
+}
